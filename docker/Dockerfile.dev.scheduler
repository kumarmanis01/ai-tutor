# Development Dockerfile for scheduler (cron + reconciler via scheduler:dev script)
# Uses npm (project lock file is package-lock.json).

FROM node:20-bullseye-slim AS deps
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python3 build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline

FROM node:20-bullseye-slim AS dev
WORKDIR /workspace
ENV NODE_ENV=development
ENV NODE_OPTIONS=--inspect=0.0.0.0:9231
COPY --from=deps /workspace/node_modules ./node_modules
EXPOSE 9231
# scheduler:dev runs tsx worker/scheduler.ts (from package.json)
CMD ["sh","-c","node scripts/prisma-generate-with-retry.cjs && npm run scheduler:dev"]
