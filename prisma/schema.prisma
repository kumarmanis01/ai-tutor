model FreeTierUsage {
  id           String   @id @default(cuid())
  studentId    String   @unique
  periodStart  DateTime
  sessionsUsed Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([studentId, periodStart])
}

model Misconception {
