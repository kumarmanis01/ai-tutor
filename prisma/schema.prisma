// ── F-STU-021: Full Syllabus Mock Exam ────────────────────────────────────────

/// Board-pattern full mock exam. Each exam spans the full syllabus for a
/// subject/grade/board and contains 3 sections (A=MCQ, B=short, C=long).
model MockExam {
  id          String    @id @default(cuid())
  title       String
  subjectId   String
  grade       Int
  board       String
  totalMarks  Int       @default(80)
  durationMin Int       @default(180)
  version     Int       @default(1)
  /// active | archived
  status      String    @default("active")
  createdAt   DateTime  @default(now())

  subject  SubjectDef          @relation(fields: [subjectId], references: [id])
  sections MockExamSection[]
  attempts MockExamAttempt[]

  @@index([subjectId, grade, board, status])
}

model MockExamSection {
  id           String  @id @default(cuid())
  mockExamId   String
  title        String
  order        Int
  totalMarks   Int
  instructions String?

  mockExam        MockExam                 @relation(fields: [mockExamId], references: [id])
  questions       MockExamQuestion[]
  sectionAttempts MockExamSectionAttempt[]

  @@index([mockExamId])
}

model MockExamQuestion {
  id         String @id @default(cuid())
  sectionId  String
  questionId String
  marks      Int    @default(1)
  order      Int

  section  MockExamSection @relation(fields: [sectionId], references: [id])
  question Question        @relation(fields: [questionId], references: [id])

  @@index([sectionId])
  @@index([questionId])
}

/// One student attempt at a full mock exam.
model MockExamAttempt {
  id           String    @id @default(cuid())
  mockExamId   String
  studentId    String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  scorePercent Float?
  percentile   Float?
  cohortCount  Int?
  priorityPlan String?   /// AI-generated 2-week study plan (Markdown)
  rawResult    Json?     /// { sectionId: { score, total, timeSpentSeconds } }

  mockExam        MockExam                 @relation(fields: [mockExamId], references: [id])
  student         User                     @relation(fields: [studentId], references: [id])
  sectionAttempts MockExamSectionAttempt[]

  @@index([studentId])
  @@index([mockExamId])
}

/// Per-section answer record within a mock exam attempt.
model MockExamSectionAttempt {
  id          String    @id @default(cuid())
  attemptId   String
  sectionId   String
  submittedAt DateTime?
  scorePercent Float?
  /// [{ questionId, answer, timeSpentSeconds }]
  answers     Json?

  attempt MockExamAttempt @relation(fields: [attemptId], references: [id])
  section MockExamSection @relation(fields: [sectionId], references: [id])

  @@unique([attemptId, sectionId])
  @@index([attemptId])
}
