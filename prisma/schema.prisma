/// FILE OBJECTIVE:
/// - Prisma schema defining application models for the project.
///
/// LINKED UNIT TEST:
/// - tests/unit/prisma/schema.spec.ts
///
/// EDIT LOG:
/// - 2026-02-21T00:00:00Z | copilot | added student learning profile fields
/// - 2026-03-07T00:00:00Z | Manish Kumar | add OVERVIEW to SessionPhase; SESSION_OVERVIEW_VIEWED to SessionEventType
/// - 2026-04-08T00:00:00Z | copilot | add MISCONCEPTION_HIGH_PREVALENCE alert type
/// - 2026-04-09T00:00:00Z | copilot | add excludeFromParentReport to ParentStudent
/// - 2026-04-10T00:00:00Z | copilot | add PaymentCustomer & PaymentMethod models for stored payment methods
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(cuid())
  name                        String?
  email                       String?                      @unique
  phone                       String?                      @unique
  emailVerified               DateTime?
  image                       String?
  parentEmail                 String?
  // Parent email OTP verified at (under-18 gate).
  parentVerifiedAt            DateTime?
  /// When true, student must complete parent verification regardless of age.
  requiresParentVerification  Boolean                      @default(false)
  // Self-reported age (integer). Used for under-13 / under-18 parent verification gates.
  age                         Int?
  // Parent phone used for under-13 verification (not unique; families can share).
  
  role                        UserRole                     @default(user)
  country                     String?
  language                    LanguageCode
  grade                       String?
  board                       String?
  subjects                    String[]                     @default([])
  points                      Int                          @default(0)
  // Cumulative XP for level progression (1-10).
  totalXp                     Int                          @default(0)
  // Current level derived from totalXp (1-10).
  level                       Int                          @default(1)
  // Consecutive days with >=1 learning session.
  currentStreak               Int                          @default(0)
  longestStreak               Int                          @default(0)
  // Date of last completed session (date-only; time ignored).
  lastSessionDate             DateTime?
  welcomeEmailSent            Boolean                      @default(false)
  passwordHash                String?
  todaysFreeQuestionsCount    Int                          @default(3)
  subscriptionStatus          String                       @default("free")
  subscriptionExpiry          DateTime?
  status                      String?
  createdAt                   DateTime                     @default(now())
  accounts                    Account[]
  apiUsages                   ApiUsage[]
  approvalAudits              ApprovalAudit[]
  adminActions                AuditLog[]                   @relation("AdminActions")
  bookmarks                   Bookmark[]
  challengeParticipations     ChallengeParticipation[]
  chats                       Chat[]
  chatHistories               ChatHistory[]
  contentRecommendations      ContentRecommendation[]
  conversations               Conversation[]
  events                      Event[]
  learningSessions            LearningSession[]
  notes                       Note[]
  noteDownloads               NoteDownload[]
  parentRelations             ParentStudent[]              @relation("ParentRelations")
  studentRelations            ParentStudent[]              @relation("StudentRelations")
  payments                    Payment[]
  invoices                    Invoice[]
  phoneOtps                   PhoneOtp[]
  // Stored payment customers and methods for this user
  paymentCustomers            PaymentCustomer[]
  paymentMethods              PaymentMethod[]
  
  
  referralsCreated            Referral[]                   @relation("ReferralCreator")
  redeemedReferrals           Referral[]                   @relation("ReferralRedeemer")
  Room                        Room[]
  sessions                    Session[]
  studentLearningProfile      StudentLearningProfile?
  studentQuestions            StudentQuestion[]
  studentStreaks              StudentStreak[]
  studentTopicMastery         StudentTopicMastery[]
  studentTopicProgress        StudentTopicProgress[]
  structuredSessions          StructuredSession[]
  homeworkAssignments         HomeworkAssignment[]
  homeRecommendationDecisions HomeRecommendationDecision[]
  subscriptions               Subscription[]
  testResults                 TestResult[]
  generatedStudyContent       GeneratedStudyContent[]
  studyBookmarks              StudentStudyBookmark[]
  dailyTasks                  DailyTask[]
  recoveryEvents              RecoveryEvent[]
  parentInvitesSent           ParentInvite[]               @relation("ParentInvite_student")
  parentInvitesConsumed       ParentInvite[]               @relation("ParentInvite_consumedByParent")
  /// IANA timezone for daily habit (e.g. Asia/Kolkata). Null => UTC.
  timezone                    String?
  studentEngagementStats      StudentEngagementStats?
  engagementProcessedSessions EngagementProcessedSession[]
  studentFeatureFlags         StudentFeatureFlag[]         @relation("StudentFeatureFlags")
  studentXpRecords            StudentXP[]
  userBadges                  UserBadge[]
  mockExamAttempts            MockExamAttempt[]  /// F-STU-021: back-relation
  learningPlans               LearningPlan[]
  /// AC-06 (F-STU-030): keys of unlocked cosmetic items (avatar frames, profile themes).
  /// Populated by unlockCosmeticsForStreak() when streak milestones are reached.
  cosmeticUnlocks             String[]           @default([])
  /// AC-06 (F-STU-004): self-reported learning style ('visual' | 'verbal' | 'practice' | 'mixed').
  /// Used by Vidya to adapt explanations. Collected during onboarding profile setup.
  learningStyle               LearningStyle?
  consents                    Consent[]
  parentProfile               ParentProfile?
  doubtEscalations            DoubtEscalation[]
  sessionQuestionFlags        SessionQuestionFlag[]
  pushSubscriptions           PushSubscriptionRecord[]
  deletionRequest             DeletionRequest?
  diagnosticSessions          DiagnosticSession[]
  studentMisconceptions       StudentMisconception[]
}

model PaymentOrder {
  id              String    @id @default(cuid())
  studentId       String
  razorpayOrderId String    @unique
  amount          Int
  currency        String    @default("INR")
  status          String    @default("created")
  providerIdempotencyKey String?
  planMonths      Int       @default(1)
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@index([studentId])
  @@index([razorpayOrderId])
}

/// Per-student XP ledger; totalXp on User is the source of truth.
model StudentXP {
  id        String   @id @default(cuid())
  studentId String
  source    String // 'session_correct' | 'streak_bonus' | 'revision_complete' | 'badge'
  amount    Int
  sessionId String?
  awardedAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, awardedAt])
}

/// Badge definition -- one row per badge type. Auto-seeded on first award via upsert.
model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String
  icon        String
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

/// Badge awarded to a student. @@unique prevents double-awarding.
model UserBadge {
  id        String   @id @default(cuid())
  studentId String
  badgeKey  String
  earnedAt  DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge @relation(fields: [badgeKey], references: [key])

  @@unique([studentId, badgeKey])
  @@index([studentId])
}

/// Per-student feature flags used for staged rollouts + kill switch gating.
model StudentFeatureFlag {
  id        String   @id @default(cuid())
  studentId String
  /// Key for the feature, e.g. "AI_TUTOR".
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentFeatureFlags", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, key], name: "studentId_key")
  @@index([key, enabled], name: "idx_studentfeatureflag_key_enabled")
  @@index([studentId], name: "idx_studentfeatureflag_studentId")
}

model DailyCostMetric {
  id             String   @id @default(cuid())
  date           DateTime @unique
  sessions       Int
  totalCostUsd   Float
  costPerSession Float
  createdAt      DateTime @default(now())
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  ip        String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  messages  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Chat {
  id             String        @id @default(cuid())
  userId         String?
  role           String
  content        String
  conversationId String?
  subject        String?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId, conversationId])
  @@index([subject])
  @@index([userId, subject])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chats     Chat[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  metadata  Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

/// Analytics events collected from learners (Phase 10)
model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  courseId  String?
  lessonIdx Int?
  metadata  Json
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([courseId])
}

model ContentSuggestion {
  id             String             @id @default(cuid())
  courseId       String
  scope          SuggestionScope
  targetId       String
  type           SuggestionType
  severity       SuggestionSeverity
  message        String
  evidenceJson   Json
  status         SuggestionStatus   @default(OPEN)
  createdAt      DateTime           @default(now())
  sourceSignalId String?

  @@unique([sourceSignalId, type, targetId])
  @@index([courseId])
}

/// Phase 12 — Regeneration jobs created from ACCEPTED ContentSuggestion
model RegenerationJob {
  id              String                 @id @default(cuid())
  suggestionId    String
  targetType      RegenerationTargetType
  targetId        String
  instructionJson Json
  status          RegenerationJobStatus  @default(PENDING)
  outputRef       Json?
  errorJson       Json?
  createdBy       String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  lockedAt        DateTime?              @db.Timestamp(6)
  completedAt     DateTime?              @db.Timestamp(6)
  retryOfJobId    String?
  retryIntentId   String?
  outputs         RegenerationOutput?

  @@unique([suggestionId, targetType, targetId])
  @@unique([suggestionId, targetType, targetId], map: "regenerationjob_unique_suggestion_target")
  @@index([lockedAt], map: "idx_regenerationjob_lockedAt")
  @@index([status], map: "idx_regenerationjob_status")
  @@index([suggestionId], map: "idx_regenerationjob_suggestionId")
}

/// Persisted outputs created by regeneration jobs. Immutable.
model RegenerationOutput {
  id          String                 @id @default(cuid())
  jobId       String                 @unique
  targetType  RegenerationTargetType
  targetId    String
  contentJson Json
  createdAt   DateTime               @default(now())
  job         RegenerationJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([targetId], map: "idx_regenerationoutput_targetId")
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  plan         String /// individual, family
  billingCycle String /// monthly, annual
  startDate    DateTime
  endDate      DateTime
  /// Credit balance in paise to apply on future invoices (prorated refunds/store credit)
  creditBalance Int      @default(0)
  active       Boolean  @default(false)
  childSlots   Int      @default(1) /// number of child accounts included
  /// JSON meta for subscription: { childIds: string[] } etc.
  meta         Json?
  /// Dunning state: number of retry attempts performed (0..3)
  dunningAttempts Int    @default(0)
  lastDunningAt    DateTime?
  /// If set, subscription remains active until this timestamp while parent is in grace period
  graceUntil       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  paymentId    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Installments linked to this subscription (one-to-many)
  installments  Installment[]

  @@index([userId])
}

model Installment {
  id                  String            @id @default(cuid())
  subscriptionId      String
  subscription        Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number              Int               // installment index (1..n)
  dueAt               DateTime
  amount              Int               // amount in paise
  currency            String            @default("INR")
  status              InstallmentStatus @default(PENDING)
  provider            String?           // e.g. 'razorpay'
  providerPaymentId   String?           // provider payment/transaction id when paid
  paymentId           String?           // local Payment.id when reconciled
  attemptCount        Int               @default(0)
  lastAttemptAt       DateTime?
  paidAt              DateTime?
  meta                Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  payment             Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([dueAt])
  @@unique([subscriptionId, number])
}

/// Parent-defined controls per child: screen time, subject toggles, focus mode
model ParentChildControl {
  id                String   @id @default(cuid())
  parentId          String
  studentId         String
  dailyTimeLimitMin Int? /// null = unlimited
  allowedSubjects   String[] @default([]) /// empty = all subjects allowed
  focusMode         String   @default("balanced") /// balanced, exam_prep, concept_focus
  studyHoursStart   String? /// e.g. "09:00" (24h format)
  studyHoursEnd     String? /// e.g. "21:00"
  /// Pause controls set by parent: when true, sessions during pause do not count
  /// against free-tier limits. `pausedUntil` is optional — null => paused indefinitely.
  isPaused          Boolean  @default(false)
  pausedUntil       DateTime?
  pauseReason       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([parentId, studentId])
  @@index([studentId])
}

/// Worker lifecycle table — persistent source of truth for worker state
model WorkerLifecycle {
  id              String       @id @default(cuid())
  type            String
  host            String?
  pid             Int?
  status          WorkerStatus @default(STARTING)
  startedAt       DateTime?
  stoppedAt       DateTime?
  lastHeartbeatAt DateTime?
  meta            Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([lastHeartbeatAt])
}

/// JobLock table used to prevent overlapping job executions
model JobLock {
  jobName     String   @id
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lockedUntil])
}

model Room {
  id          String    @id @default(cuid())
  name        String
  subject     String?
  description String?
  isPrivate   Boolean   @default(false)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  grade       String?
  topic       String?
  createdByAI Boolean   @default(false)
  messages    Message[]
  creator     User?     @relation(fields: [createdBy], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String?
  sender    String?
  role      String
  type      String?
  content   String
  createdAt DateTime @default(now())
  aiMeta    Json?
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  provider      String
  providerIdempotencyKey String?
  status        String
  createdAt     DateTime @default(now())
  transactionId String?
  orderId       String?
  plan          String?
  billingCycle  String?
  meta          Json?
  user          User     @relation(fields: [userId], references: [id])
  invoice       Invoice?
  // Link back to installments paid by this payment
  installments  Installment[]
  // Payment events/audit traces
  events        PaymentEvent[]
  @@unique([provider, providerIdempotencyKey], map: "uniq_payment_provider_idempotency")
}

/// PaymentEvent: immutable audit/events for payment lifecycle and gateway/webhook traces.
model PaymentEvent {
  id                       String   @id @default(cuid())
  paymentId                String?  // optional link to Payment
  userId                   String?
  provider                 String   // e.g. 'razorpay' | 'credit' | 'stripe'
  providerIdempotencyKey   String?
  transactionId            String?
  orderId                  String?
  eventType                String   // e.g. 'order.created','charge.attempt','charge.succeeded','webhook.received'
  payload                  Json?
  amount                   Int?
  status                   String?
  createdAt                DateTime @default(now())

  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([provider, providerIdempotencyKey])
  @@index([paymentId])
  @@index([userId])
}


model PaymentCustomer {
  id                   String   @id @default(cuid())
  userId               String
  provider             String   // e.g. 'razorpay'
  providerCustomerId   String?  @unique
  meta                 Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  paymentMethods       PaymentMethod[] @relation("CustomerPaymentMethods")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
}

model PaymentMethod {
  id                       String   @id @default(cuid())
  userId                   String
  customerId               String?
  provider                 String
  providerPaymentMethodId  String?  @unique
  type                     String   // 'card' | 'upi' | 'netbanking'
  last4                    String?
  cardBrand                String?
  expiryMonth              Int?
  expiryYear               Int?
  isDefault                Boolean  @default(false)
  verified                 Boolean  @default(false)
  meta                     Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer PaymentCustomer? @relation("CustomerPaymentMethods", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([provider])
}

/// Invoice sequence used to allocate sequential invoice numbers.
model InvoiceSequence {
  id         String   @id
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// GST-compliant invoice record. The PDF is stored in object storage
/// and referenced by `fileUrl`.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber Int      @unique
  userId        String
  paymentId     String?   @unique
  studentId     String?
  amount        Int
  currency      String   @default("INR")
  hsnCode       String?
  gstin         String?
  taxBreakdown  Json?
  fileUrl       String?
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id            String           @id @default(cuid())
  adminId       String? // who performed the action (null = system)
  targetEntity  String // 'User' | 'Worker' | 'HydrationJob' | 'TopicNote' | etc.
  targetId      String // ID of the affected entity
  action        AdminActionType? // typed enum; null for non-admin system events
  previousValue Json? // state before change
  newValue      Json? // state after change
  reason        String? // required for destructive actions
  ipAddress     String?
  details       Json? // retained for legacy system-event metadata
  // Archival metadata: set by archival worker only (allowed UPDATEs)
  archived      Boolean?         @default(false)
  archivedAt    DateTime?
  archiveUrl    String?
  createdAt     DateTime         @default(now())
  admin         User?            @relation("AdminActions", fields: [adminId], references: [id])

  @@index([targetEntity, targetId])
  @@index([adminId, createdAt])
}

/// Admin key-value flags (e.g. parent_reports_paused, content_generation_paused).
model AdminConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ApiUsage {
  id       String   @id @default(cuid())
  userId   String?
  endpoint String
  method   String
  count    Int      @default(1)
  lastUsed DateTime @default(now())
  metadata Json?
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint, method], name: "userId_endpoint_method")
}

model Referral {
  id         String    @id @default(cuid())
  code       String    @unique
  createdBy  String
  redeemedBy String?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
  metadata   Json?
  creator    User      @relation("ReferralCreator", fields: [createdBy], references: [id])
  redeemer   User?     @relation("ReferralRedeemer", fields: [redeemedBy], references: [id])
}

model CoursePackage {
  id         String              @id @default(cuid())
  syllabusId String
  version    Int
  status     CoursePackageStatus @default(PUBLISHED)
  /// Frozen JSON blob (validated before insert)
  json       Json
  createdAt  DateTime            @default(now())

  @@unique([syllabusId, version])
  @@index([syllabusId])
}

/// Persisted syllabus artifacts generated/approved in Phase 6
/// Persisted syllabus artifacts generated/approved in Phase 6
model Syllabus {
  id        String         @id @default(cuid())
  title     String
  version   String
  status    SyllabusStatus @default(DRAFT)
  json      Json
  createdAt DateTime       @default(now())

  @@index([status])
}

model Challenge {
  id             String                   @id @default(cuid())
  key            String                   @unique
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  rewardPoints   Int                      @default(0)
  createdAt      DateTime                 @default(now())
  participations ChallengeParticipation[]
}

model ChallengeParticipation {
  id            String    @id @default(cuid())
  challengeId   String
  userId        String
  status        String    @default("joined")
  score         Int?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  rewardApplied Boolean   @default(false)
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model StudentQuestion {
  id                 String           @id @default(cuid())
  studentId          String
  type               String
  subject            String?
  grade              String?
  content            String?
  status             String           @default("processing")
  createdAt          DateTime         @default(now())
  answeredAt         DateTime?
  answerSummary      String?
  answerStepsJson    Json?
  aiMetadata         Json?
  helpfulCount       Int              @default(0)
  isFlagged          Boolean          @default(false)
  contentSafetyScore Int?
  processingAttempts Int?             @default(0)
  lastUpdatedAt      DateTime         @updatedAt
  answers            QuestionAnswer[]
  flags              QuestionFlag[]
  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model QuestionAnswer {
  id           String          @id @default(cuid())
  questionId   String
  responder    String?
  content      String
  contentJson  Json?
  createdAt    DateTime        @default(now())
  helpfulCount Int             @default(0)
  question     StudentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionFlag {
  id            String          @id @default(cuid())
  questionId    String
  flagType      String
  severity      String          @default("low")
  autoFlagged   Boolean         @default(false)
  reviewerNotes String?
  status        String          @default("pending")
  flaggedBy     String?
  flaggedAt     DateTime        @default(now())
  resolvedAt    DateTime?
  question      StudentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ParentStudent {
  id         String           @id @default(cuid())
  parentId   String
  studentId  String
  status     ParentLinkStatus @default(active)
  inviteCode String?          @unique
  /// Pause controls set by parent: when true, sessions during pause do not count
  /// against free-tier limits. `pausedUntil` is optional — null => paused indefinitely.
  isPaused    Boolean  @default(false)
  /// When true, this student will be excluded from parent-facing reports/digests
  /// (used for privacy / opt-out per child). Defaults to false.
  excludeFromParentReport Boolean @default(false)
  /// Per-child opt-out for inactivity alerts (parent can mute inactivity alerts for this child)
  inactivityOptOut Boolean @default(false)
  pausedUntil DateTime?
  pauseReason String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  parent     User             @relation("ParentRelations", fields: [parentId], references: [id], onDelete: Cascade)
  student    User             @relation("StudentRelations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@index([inviteCode])
}

/// Time-limited, single-use invite codes for parent linking.
/// - Generated by the student, redeemed by a parent.
/// - Avoids placeholder ParentStudent rows for pending invites.
model ParentInvite {
  id                 String             @id @default(cuid())
  studentId          String
  code               String             @unique
  status             ParentInviteStatus @default(pending)
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedByParentId String?
  createdAt          DateTime           @default(now())

  student          User  @relation("ParentInvite_student", fields: [studentId], references: [id], onDelete: Cascade)
  consumedByParent User? @relation("ParentInvite_consumedByParent", fields: [consumedByParentId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([status, expiresAt])
  @@index([consumedByParentId])
}

/// Pre-aggregated weekly snapshot of a student's activity for parent view
model WeeklyStudentSummary {
  id             String   @id @default(cuid())
  studentId      String
  weekStart      DateTime /// Monday 00:00 UTC
  topicsCovered  Int      @default(0)
  testsTaken     Int      @default(0)
  averageScore   Float    @default(0)
  totalMinutes   Int      @default(0)
  sessionsCount  Int      @default(0)
  subjectsActive String[] @default([])
  createdAt      DateTime @default(now())

  @@unique([studentId, weekStart])
  @@index([studentId])
}

/// Per-subject progress for a student (aggregated from topic mastery)
model SubjectProgressSummary {
  id             String   @id @default(cuid())
  studentId      String
  subject        String
  board          String
  totalTopics    Int      @default(0)
  topicsCovered  Int      @default(0)
  averageMastery Float    @default(0)
  strongTopics   Int      @default(0)
  weakTopics     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([studentId, subject])
  @@index([studentId])
}

/// Flags topics where student mastery is below threshold
model AttentionFlag {
  id           String       @id @default(cuid())
  studentId    String
  topicId      String
  subject      String
  chapter      String
  masteryLevel MasteryLevel
  accuracy     Float
  reason       String /// e.g. "low_mastery", "declining_accuracy"
  resolved     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([studentId, topicId])
  @@index([studentId, resolved])
}

/// Per-subject exam readiness based on topic coverage + mastery
model ReadinessStatus {
  id              String   @id @default(cuid())
  studentId       String
  subject         String
  board           String
  topicsCovered   Int      @default(0)
  totalTopics     Int      @default(0)
  coveragePercent Float    @default(0)
  avgMastery      Float    @default(0)
  readinessScore  Float    @default(0) /// 0-100 composite score
  readinessLabel  String   @default("not_started") /// not_started, needs_work, on_track, ready
  updatedAt       DateTime @updatedAt

  @@unique([studentId, subject])
  @@index([studentId])
}

model LearningSession {
  id                   String          @id @default(cuid())
  studentId            String
  activityType         String
  activityRef          String?
  duration             Int?
  meta                 Json?
  startedAt            DateTime        @default(now())
  endedAt              DateTime?
  rating               Int?
  ratingFeedback       String?
  ratedAt              DateTime?
  createdAt            DateTime        @default(now())
  completionPercentage Int             @default(0)
  isCompleted          Boolean         @default(false)
  lastAccessed         DateTime        @default(now())
  currentQuestionIndex Int?
  sessionData          Json?
  difficultyLevel      DifficultyLevel
  estimatedTimeMinutes Int?
  actualTimeSpent      Int             @default(0)
  student              User            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model ContentRecommendation {
  id           String    @id @default(cuid())
  userId       String
  contentId    String
  isShown      Boolean   @default(false)
  isClicked    Boolean   @default(false)
  isCompleted  Boolean   @default(false)
  isIgnored    Boolean   @default(false)
  firstShownAt DateTime?
  lastShownAt  DateTime?
  clickedAt    DateTime?
  completedAt  DateTime?
  ignoredAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])

  @@unique([userId, contentId])
  @@index([userId, isIgnored])
}

model ContentCatalog {
  id          String       @id @default(cuid())
  contentId   String       @unique
  title       String
  description String?
  url         String?
  type        String?
  subject     String
  board       String
  grade       String
  language    LanguageCode
  difficulty  String?
  tags        String[]     @default([])
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model StudentLearningProfile {
  id               String   @id @default(cuid())
  studentId        String   @unique
  weakSubjects     String[] @default([])
  strengths        Json?
  recommendations  Json?
  /// User-configurable study targets
  dailyTargetMin   Int?
  studyDaysPerWeek Int?
  updatedAt        DateTime @updatedAt
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentStreak {
  id         String    @id @default(cuid())
  studentId  String
  kind       String
  current    Int       @default(0)
  best       Int       @default(0)
  lastActive DateTime?
  updatedAt  DateTime  @updatedAt
  student    User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, kind])
}

/// Daily habit engagement cache: streak, points, last active date. Authoritative source remains StructuredSession.completedAt.
model StudentEngagementStats {
  id                     String    @id @default(cuid())
  studentId              String    @unique
  currentStreak          Int       @default(0)
  longestStreak          Int       @default(0)
  lastActiveDate         DateTime? /// Calendar date (midnight UTC) of last day with ≥1 completed session
  totalSessionsCompleted Int       @default(0)
  learningPoints         Int       @default(0)
  updatedAt              DateTime  @updatedAt
  student                User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// Idempotency: session completions already processed for engagement (points + streak). One row per sessionId.
model EngagementProcessedSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  studentId   String
  processedAt DateTime @default(now())
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentTopicMastery {
  id                 String       @id @default(cuid())
  studentId          String
  topicId            String
  subject            String
  chapter            String
  masteryLevel       MasteryLevel @default(beginner)
  accuracy           Float        @default(0)
  questionsAttempted Int          @default(0)
  lastAttemptedAt    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  student            User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([studentId, masteryLevel])
  @@index([subject, chapter])
}

model StudentTopicProgress {
  id            String   @id @default(cuid())
  studentId     String
  topicId       String
  mastery       Float    @default(0)
  practiceCount Int      @default(0)
  lastStudiedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic         TopicDef @relation(fields: [topicId], references: [id])

  @@unique([studentId, topicId])
  @@index([studentId, mastery])
  @@index([topicId])
}

model StructuredSession {
  id          String               @id @default(cuid())
  studentId   String
  topicId     String
  state       SessionPhase         @default(OVERVIEW)
  startedAt   DateTime             @default(now())
  completedAt DateTime?
  meta        Json?
  student     User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic       TopicDef             @relation(fields: [topicId], references: [id])
  homework    HomeworkAssignment[]
  events      SessionEvent[]

  @@index([studentId, state])
  @@index([studentId, completedAt])
  @@index([topicId])
}

model HomeworkAssignment {
  id        String             @id @default(cuid())
  studentId String
  topicId   String
  sessionId String?
  questions Json
  status    HomeworkStatus     @default(PENDING)
  dueDate   DateTime
  score     Float?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  student   User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic     TopicDef           @relation(fields: [topicId], references: [id])
  session   StructuredSession? @relation(fields: [sessionId], references: [id])

  answers HomeworkAnswer[]

  @@index([studentId, status])
  @@index([topicId])
  @@index([sessionId])
}

model HomeworkAnswer {
  id            String             @id @default(cuid())
  assignmentId  String
  questionId    String
  studentAnswer Json
  isCorrect     Boolean?
  createdAt     DateTime           @default(now())
  assignment    HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, questionId])
  @@index([assignmentId])
}

enum HomeworkStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  GRADED
  OVERDUE
}

enum SessionPhase {
  /// Initial gate: student sees topic summary and objectives before diving in.
  OVERVIEW
  EXPLANATION
  PRACTICE
  TEST
  HOMEWORK
  COMPLETE
  /// GAP-05: Session expired (stale > 48h); archived, not resumed.
  EXPIRED
}

enum SessionEventType {
  SESSION_STARTED
  SESSION_OVERVIEW_VIEWED
  PHASE_STARTED
  QUESTION_ANSWERED
  HOMEWORK_SUBMITTED
  SESSION_COMPLETED
}

model SessionEvent {
  id        String           @id @default(cuid())
  sessionId String
  eventType SessionEventType
  timestamp DateTime         @default(now())
  metadata  Json?

  session StructuredSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([sessionId, eventType])
}

model PracticeTest {
  id        String   @id @default(cuid())
  title     String
  subject   String?
  grade     String?
  questions Json?
  createdAt DateTime @default(now())
}

model TestResult {
  id               String            @id @default(cuid())
  testId           String
  studentId        String
  score            Float?
  rawResult        Json?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime          @default(now())
  AttemptQuestions AttemptQuestion[]
  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Note {
  id          String         @id @default(cuid())
  studentId   String?
  subject     String?
  title       String
  content     String
  contentJson Json?
  isPublic    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  student     User?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  downloads   NoteDownload[]
}

model NoteDownload {
  id        String   @id @default(cuid())
  noteId    String
  userId    String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([noteId, userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  studentId String
  type      String
  refId     String
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
}

model Question {
  id            String                @id @default(cuid())
  subject       String?
  chapter       String?
  grade         String?
  board         String?
  topicId       String? /// canonical topic reference — backfilled for legacy rows
  type          String
  difficulty    String?
  /// IRT 3PL parameters. a = discrimination (default 1.0), b = difficulty, c = guessing (default 0.2).
  /// All nullable: selector falls back to defaults when null.
  irt_a         Float? /// Discrimination; typical range 0.5–2.5
  irt_b         Float? /// Difficulty: recall -1.5 to -0.5, single-step -0.5 to 0.5, multi-step 0.5 to 2.0
  irt_c         Float? /// Pseudo-guessing; typical range 0.0–0.35
  prompt        String
  choices       Json?
  correctAnswer String?
  source        String?
  status        QuestionStatus        @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  topic            TopicDef?             @relation(fields: [topicId], references: [id])
  attempts         AttemptQuestion[]
  sessionFlags     SessionQuestionFlag[]
  mockExamQuestions MockExamQuestion[]   /// F-STU-021: back-relation

  @@index([topicId])
  @@index([status])
  @@index([board, grade, subject, status])
}

model AttemptQuestion {
  id            String     @id @default(cuid())
  testResultId  String
  questionId    String
  order         Int
  timeSpent     Int?
  result        String?
  awardedPoints Int?
  answer        Answer?
  question      Question   @relation(fields: [questionId], references: [id])
  testResult    TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@index([testResultId])
  @@index([questionId])
}

model Answer {
  attemptQuestionId String          @unique
  rawAnswer         String?
  normalizedAnswer  String?
  autoScore         Int?
  reviewerScore     Int?
  confidence        Float?
  attemptQuestion   AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
}

model Board {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  lifecycle SoftDeleteStatus @default(active)
  createdAt DateTime         @default(now())
  classes   ClassLevel[]
}

model ClassLevel {
  id        String           @id @default(cuid())
  grade     Int
  slug      String
  boardId   String
  lifecycle SoftDeleteStatus @default(active)
  createdAt DateTime         @default(now())
  board     Board            @relation(fields: [boardId], references: [id])
  subjects  SubjectDef[]

  @@unique([boardId, grade], name: "boardId_grade")
}

model SubjectDef {
  id                  String               @id @default(cuid())
  name                String
  slug                String
  classId             String
  lifecycle           SoftDeleteStatus     @default(active)
  createdAt           DateTime             @default(now())
  chapters            ChapterDef[]
  class               ClassLevel           @relation(fields: [classId], references: [id])
  concepts            Concept[]
  boardSubjectConfigs BoardSubjectConfig[]
  diagnosticSessions  DiagnosticSession[]
  mockExams           MockExam[]           /// F-STU-021: back-relation

  @@unique([classId, slug], name: "classId_slug")
}

model ChapterDef {
  id                  String               @id @default(cuid())
  name                String
  slug                String
  order               Int
  version             Int                  @default(1)
  status              ApprovalStatus       @default(draft)
  lifecycle           SoftDeleteStatus     @default(active)
  subjectId           String
  createdAt           DateTime             @default(now())
  subject             SubjectDef           @relation(fields: [subjectId], references: [id])
  topics              TopicDef[]
  boardChapterWeights BoardChapterWeight[]

  @@unique([subjectId, slug, version])
}

model TopicDef {
  id                 String                 @id @default(cuid())
  name               String
  slug               String
  order              Int
  chapterId          String
  status             ApprovalStatus         @default(draft)
  lifecycle          SoftDeleteStatus       @default(active)
  parentId           String?
  createdAt          DateTime               @default(now())
  logs               AIContentLog[]
  tests              GeneratedTest[]
  chapter            ChapterDef             @relation(fields: [chapterId], references: [id])
  notes              TopicNote[]
  questions          Question[]
  progress           StudentTopicProgress[]
  structuredSessions StructuredSession[]
  homework           HomeworkAssignment[]
  concepts           Concept[]

  @@unique([chapterId, slug])
}

/// Concept-level taxonomy for IRT, prereqs, and RAG. One topic can have many concepts.
model Concept {
  id                      String                @id @default(cuid())
  topicId                 String
  subjectId               String /// Denormalized for queries: concepts WHERE subjectId IN (...)
  name                    String
  description             String? /// Required for launch slice; null breaks AI prompt
  irt_b                   Float? /// Expected difficulty: recall -1.5 to -0.5, single-step -0.5 to 0.5, multi-step 0.5 to 2.0
  bloomLevel              String? /// e.g. remember, understand, apply
  prerequisiteConceptIds  String[]              @default([])
  commonlyConfusedWithIds String[]              @default([])
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  topic                   TopicDef              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subject                 SubjectDef            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  learningPlanItems       LearningPlanItem[]
  conceptStates           StudentConceptState[]

  @@index([subjectId])
  @@index([topicId])
}

/// Per-chapter exam mark weight (e.g. CBSE Grade 10 Maths). Used for readiness score.
model BoardChapterWeight {
  id          String     @id @default(cuid())
  chapterId   String
  weightMarks Int /// Marks allocated to this chapter in board exam
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chapter     ChapterDef @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId])
  @@index([chapterId])
}

/// Core vs optional subject per board+grade. Unblocks onboarding subject picker.
model BoardSubjectConfig {
  id           String     @id @default(cuid())
  subjectDefId String
  isCore       Boolean    @default(true) /// Mandatory for that board+grade
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subjectDef   SubjectDef @relation(fields: [subjectDefId], references: [id], onDelete: Cascade)

  @@unique([subjectDefId])
  @@index([subjectDefId])
}

/// RAG curriculum chunks; tag with conceptIds for retrieval. pgvector embedding column added separately if needed.
model CurriculumChunk {
  id           String                       @id @default(cuid())
  conceptIds   String[]                     @default([]) /// Empty = untagged; verify for launch slice
  content      String? /// Chunk text for display/grounding
  board        String?
  subject      String?
  grade        String?
  contentHash  String? /// SHA-256 of content; used for idempotent ingest
  version      Int                          @default(1) /// Incremented when content changes
  supersededBy String? /// ID of newer chunk if this one was updated
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  embedding    Unsupported("vector(1536)")?

  @@index([conceptIds])
  @@index([contentHash])
  @@index([board, subject, grade])
}

model IngestRunLog {
  id                  String   @id @default(cuid())
  runAt               DateTime @default(now())
  fileSource          String?
  board               String?
  subjectId           String?
  chunksCreated       Int      @default(0)
  chunksUpdated       Int      @default(0)
  embeddingsGenerated Int      @default(0)
  errors              Int      @default(0)
  durationMs          Int?
  errorDetails        Json?
}

model TopicNote {
  id              String           @id @default(cuid())
  topicId         String
  language        LanguageCode
  version         Int              @default(1)
  status          ApprovalStatus   @default(draft)
  lifecycle       SoftDeleteStatus @default(active)
  title           String
  contentJson     Json
  source          String
  editedByTeacher Boolean          @default(false)
  teacherNotes    String?
  createdAt       DateTime         @default(now())
  topic           TopicDef         @relation(fields: [topicId], references: [id])

  @@unique([topicId, language, version])
}

model GeneratedTest {
  id         String              @id @default(cuid())
  topicId    String
  title      String
  difficulty DifficultyLevel
  language   LanguageCode
  version    Int                 @default(1)
  status     ApprovalStatus      @default(draft)
  lifecycle  SoftDeleteStatus    @default(active)
  createdAt  DateTime            @default(now())
  questions  GeneratedQuestion[]
  topic      TopicDef            @relation(fields: [topicId], references: [id])

  @@unique([topicId, difficulty, language, version])
}

model GeneratedQuestion {
  id          String        @id @default(cuid())
  testId      String
  type        String
  question    String
  options     Json?
  answer      Json?
  explanation String?
  marks       Int?
  sourceJobId String?
  createdAt   DateTime      @default(now())
  test        GeneratedTest @relation(fields: [testId], references: [id])
}

model AIContentLog {
  id           String       @id @default(cuid())
  model        String
  promptType   String
  board        String?
  grade        Int?
  subject      String?
  chapter      String?
  topic        String?
  language     LanguageCode
  tokensIn     Int?
  tokensOut    Int?
  tokensUsed   Int?
  costUsd      Float?
  success      Boolean
  status       String       @default("success")
  error        String?
  requestBody  Json?
  responseBody Json?
  topicId      String?
  schemaHash   String? // prompt/schema fingerprint for idempotency
  createdAt    DateTime     @default(now())
  topicRef     TopicDef?    @relation(fields: [topicId], references: [id])

  @@index([promptType])
  @@index([board, grade, subject])
  @@index([createdAt])
  @@index([promptType, schemaHash])
}

model AITutorTurnLog {
  id               String       @id @default(cuid())
  sessionId        String
  callType         String // 'tutor:teach' | 'tutor:hint' | 'tutor:eval'
  model            String
  inputTokens      Int
  outputTokens     Int
  costUsd          Float
  latencyMs        Int
  tag              String?
  stage            String?
  safetyFlagged    Boolean      @default(false)
  cached           Boolean      @default(false)
  ragChunksUsed    String[]     @default([])
  frustrationScore Float?
  qualityFlag      QualityFlag?
  qualityNote      String?
  createdAt        DateTime     @default(now())

  @@index([sessionId])
  @@index([callType])
  @@index([createdAt])
  @@index([qualityFlag])
}

enum QualityFlag {
  HALLUCINATION
  INCORRECT_EXPLANATION
  POOR_PEDAGOGY
  OFF_TOPIC
  DIRECT_ANSWER_GIVEN
  SAFETY_CONCERN
}

model SafetyEvent {
  id           String    @id @default(cuid())
  triggerType  String // 'PII' | 'JAILBREAK' | 'UNSAFE_OUTPUT' | 'DISTRESS'
  sessionId    String?
  turnId       String?
  studentId    String
  severity     String // 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL'
  /// Redacted preview of the flagged input (never raw PII). Truncated server-side.
  inputPreview String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolution   String?

  @@index([studentId])
  @@index([triggerType])
  @@index([severity])
  @@index([createdAt])
  @@index([resolvedAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HydrationJob {
  id             String          @id @default(cuid())
  jobType        JobType
  board          String?
  grade          Int?
  subject        String?
  subjectId      String?
  chapterId      String?
  topicId        String?
  parentJobId    String?
  rootJobId      String?
  hierarchyLevel Int             @default(0)
  language       LanguageCode
  difficulty     DifficultyLevel
  status         JobStatus       @default(pending)
  attempts       Int             @default(0)
  maxAttempts    Int?            @default(3)
  lockedAt       DateTime?
  lastError      String?
  completedAt    DateTime?
  contentReady   Boolean         @default(false)
  inputParams    Json?
  traceId        String?

  // Progress tracking (updated by reconciler)
  chaptersExpected   Int @default(0)
  chaptersCompleted  Int @default(0)
  topicsExpected     Int @default(0)
  topicsCompleted    Int @default(0)
  notesExpected      Int @default(0)
  notesCompleted     Int @default(0)
  questionsExpected  Int @default(0)
  questionsCompleted Int @default(0)

  // Cost tracking
  estimatedCostUsd      Float?
  actualCostUsd         Float? @default(0)
  estimatedDurationMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobType, status])
  @@index([parentJobId])
  @@index([rootJobId])
  @@index([rootJobId, status])
  @@index([lockedAt])
  @@index([hierarchyLevel])
}

model Outbox {
  id        String    @id @default(cuid())
  queue     String
  payload   Json
  meta      Json?
  sentAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([queue, sentAt])
}

/// Parent-facing notification audit record for compliance and "last alert sent" views
model ParentNotification {
  id         String   @id @default(cuid())
  parentId   String
  studentId  String?  
  type       String   // 'inactivity' | 'digest' | 'milestone'
  channel    String   // 'email' | 'sms' | 'whatsapp' | 'unknown'
  subject    String?
  body       Json?
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([parentId, sentAt])
}

/// Dead-letter table for outbox rows that exceed MAX_ATTEMPTS (RISK-04).
model OutboxDeadLetter {
  id               String   @id @default(cuid())
  originalOutboxId String
  queue            String
  payload          Json
  meta             Json?
  attempts         Int      @default(0)
  deadLetterReason String
  failedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([queue])
  @@index([failedAt])
}

model StudentContentPreference {
  id         String          @id @default(cuid())
  studentId  String
  subject    String?
  difficulty DifficultyLevel
  language   LanguageCode
  createdAt  DateTime        @default(now())

  @@index([studentId])
}

model StudentConceptState {
  id              String    @id @default(cuid())
  studentId       String
  conceptId       String
  concept         Concept   @relation(fields: [conceptId], references: [id])
  masteryScore    Float     @default(0.0)
  nextReviewAt    DateTime?
  lastInteraction DateTime  @default(now())
  attemptCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masteryVariance Float @default(0.1)
  theta           Float @default(0.0)
  stability       Float @default(1.0)
  retention       Float @default(1.0)

  @@unique([studentId, conceptId])
  @@index([studentId])
  @@index([nextReviewAt])
