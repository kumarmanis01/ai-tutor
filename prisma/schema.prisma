model AnswerEvent {
  id            String   @id @default(cuid())
  studentId     String
  sessionId     String
  conceptId     String
  questionId    String?
  isCorrect     Boolean
  studentAnswer String
  source        String
  createdAt     DateTime @default(now())

  @@index([studentId, conceptId])
  @@index([studentId, createdAt])
}

/// Student doubt Q&A pairs for reuse; embedding column added in production when pgvector is available.
model DoubtKb {
  id        String   @id @default(cuid())
  studentId String
  sessionId String
  conceptId String?
  question  String
  answer    String
  createdAt DateTime @default(now())

  // T26 — shared KB fields (subjectId-scoped, pgvector dedup)
  subjectId          String?
  questionText       String?
  answerText         String?
  embedding          Unsupported("vector(1536)")?
  timesServed        Int                          @default(1)
  alternatePhrasings String[]                     @default([])
  updatedAt          DateTime                     @default(now()) @updatedAt

  @@index([studentId, conceptId])
  @@index([conceptId])
  @@index([subjectId])
}

model FreeTierUsage {
  id           String   @id @default(cuid())
  studentId    String   @unique
  periodStart  DateTime
  sessionsUsed Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([studentId, periodStart])
}

model Misconception {
  id              String                 @id @default(cuid())
  subjectId       String
  conceptId       String
  name            String
  description     String
  triggerPatterns String[]
  correction      String
  createdAt       DateTime @default(now())
  prevalenceRate  Float    @default(0)
  studentDetections StudentMisconception[]

  @@index([subjectId, conceptId])
}

/// AC-04 (F-STU-013): per-student misconception occurrence log.
/// Upserted each time a known misconception is detected in a tutor turn.
/// Injected into future session prompts for the same concept cluster.
model StudentMisconception {
  id              String        @id @default(cuid())
  studentId       String
  misconceptionId String
  firstDetectedAt DateTime
  lastSeenAt      DateTime
  occurrenceCount Int           @default(1)

  student         User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  misconception   Misconception @relation(fields: [misconceptionId], references: [id], onDelete: Cascade)

  @@unique([studentId, misconceptionId])
  @@index([studentId])
  @@index([studentId, misconceptionId])
}

model ApprovalAudit {
  id         String         @id @default(cuid())
  entityType String
  entityId   String
  fromStatus ApprovalStatus
  toStatus   ApprovalStatus
  actorId    String?
  reason     String?
  createdAt  DateTime       @default(now())
  actor      User?          @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ExecutionJob {
  id          String            @id @default(cuid())
  jobType     JobType
  entityType  EntityType
  entityId    String
  payload     Json
  status      JobStatus
