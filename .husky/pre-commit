#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Auto-fix smart quotes + unicode on staged files
# This runs BEFORE commit — fixes are included in the commit automatically
python3 scripts/fix-smart-quotes.py

# Re-stage any files that were auto-fixed
git add -u

# Run typecheck on production code only
npx tsc --noEmit --project tsconfig.json
