FROM node:20-slim
WORKDIR /usr/src/app

# copy package manifest first to install runtime deps only
COPY package.json package-lock.json ./
# Prevent lifecycle scripts (e.g., husky prepare) from running during image
# production installs where devDependencies are omitted and husky is not present.
RUN HUSKY=0 NPM_CONFIG_IGNORE_SCRIPTS=true npm ci --omit=dev

# copy built bundle (CI will generate it before docker build by default via context)
COPY build/runAlertEvaluator.js ./build/runAlertEvaluator.js

EXPOSE 9188
CMD ["node", "build/runAlertEvaluator.js"]
