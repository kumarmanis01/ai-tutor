FROM node:20-alpine AS builder
WORKDIR /app

# Install build tools required by some native deps
# Use --no-cache and specific mirror for faster downloads
RUN apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/v3.19/main \
    python3 make g++ bash

# Copy package manifests first to leverage Docker cache for deps
COPY package.json package-lock.json* ./

# Install all deps (including dev) so Next.js build and tools are available
# We will prune dev deps after build to keep the final image lean.
RUN npm ci --no-audit --progress=false --prefer-offline

# Copy rest of the repo and build
COPY . ./

# Ensure shell scripts have LF endings (avoid CRLF parse issues)
RUN if [ -f ./scripts/run-migrate.sh ]; then sed -i 's/\r$//' ./scripts/run-migrate.sh && chmod +x ./scripts/run-migrate.sh; fi

# Build project:
# 1. prisma generate - generate Prisma client
# 2. build:tsc - compile TypeScript to dist
# 3. build:workers - compile worker code
# 4. next build - create .next production build
RUN npm run build && npm run build:workers && npx next build

# Remove devDependencies to reduce runtime size
RUN npm prune --production || true

FROM node:20-alpine AS runner
WORKDIR /app
COPY --from=builder /app /app
ENV NODE_ENV=production

# Minimal runtime deps are already installed in /app/node_modules
# Install curl for healthchecks, netcat for port checking, postgresql-client for migrations
RUN apk add --no-cache curl netcat-openbsd postgresql-client

EXPOSE 3000
# Add a small entrypoint to route to the correct service at runtime
COPY ./scripts/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh || true
ENTRYPOINT ["/bin/sh", "/app/docker-entrypoint.sh"]

CMD ["web"]
