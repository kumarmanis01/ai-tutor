{
  "name": "ai-tutor-india",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": " CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 15 TypeScript app functionality"
  },
  "scripts": {
    "dev": "next dev",
    "dev:next": "npm run lint:orig && npm run type-check:orig && next dev",
    "dev:fast": "next dev",
    "prepare": "husky",
    "build": "node scripts/prisma-generate-with-retry.cjs && tsc -p tsconfig.build.json && npx tsc-alias -p tsconfig.build.json && node scripts/verify-dist.cjs && next build --webpack",
    "build:tsc": "tsc -p tsconfig.build.json && npx tsc-alias -p tsconfig.build.json",
    "build:prod": "node scripts/prisma-generate-with-retry.cjs && npm run build:tsc && npm run build:workers && next build",
    "start": "next start",
    "start:next": "next start",
    "export": "next export",
    "lint": "eslint \"app\" \"components\" \"lib\" \"src\"",
    "lint:orig": "eslint . --max-warnings=0",
    "test:eslint-rules": "node ./eslint-rules/tests/run-rule-tests.cjs",
    "lint:fix": "eslint \"app/**\" \"components/**\" \"lib/**\" \"scripts/**\" \"src/**\" --fix",
    "lint:quotes": "python scripts/fix-smart-quotes.py --check",
    "preflight:smart-quotes": "npm run lint:quotes",
    "preflight:lint": "npm run lint",
    "preflight:type-check": "npm run type-check",
    "preflight:unit": "npm run test:unit",
    "preflight:integration": "node scripts/run-focused-tests.cjs tests/integration/ -- --config jest.integration.config.cjs --passWithNoTests",
    "fix:quotes": "python scripts/fix-smart-quotes.py",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:orig": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
    "type-check:orig": "tsc -p tsconfig.json --noEmit",
    "clear-auth": "cross-env CONFIRM=true tsx scripts/clear-auth-tables.ts",
    "pretest": "node scripts/prisma-generate-with-retry.cjs",
    "test": "node scripts/run-focused-tests.cjs",
    "test:focused:proactive": "node scripts/run-focused-tests.cjs --suite proactive -- --runInBand --watchAll=false",
    "test:focused:proactive:pwsh": "powershell -File scripts\\run-focused-tests.ps1 -Suite proactive",
    "test:ci": "npm run lint:orig && npm run type-check:orig && npm run test:unit",
    "test:watch": "node scripts/run-focused-tests.cjs -- --watch",
    "test:coverage": "node scripts/run-focused-tests.cjs -- --coverage",
    "ci:run-tests": "npm run lint:orig && npm run type-check:orig && npm run test:coverage",
    "ci": "npm run ci:run-tests",
    "ci:unit": "npm run type-check:orig && node scripts/run-focused-tests.cjs -- --coverage --testPathPattern=tests/unit --runInBand",
    "health-check": "node scripts/health-check.js",
    "test:integration": "node tests/integration/audit-log.test.cjs",
    "test:integration:scenarios": "node scripts/run-focused-tests.cjs tests/integration/homeEngine.scenarios.withSeed.test.ts -- --testPathIgnorePatterns=\"\"",
    "seed:scenarios": "npx tsx scripts/seed-scenario-curriculum.ts",
    "ensure-mocks": "npx tsx scripts/ensure-mocks.ts",
    "validate:scenarios": "npx tsx scripts/validate-recommendation-scenarios.ts",
    "test:integration:evaluator": "tsx tests/integration/alert-evaluator.test.ts",
    "test:integration:dry-run": "node tests/integration/alert-evaluator-dry-run.test.cjs",
    "test:integration:all": "npm run test:integration && npm run test:integration:scenarios && npm run test:integration:evaluator && npm run test:integration:dry-run",
    "metrics:server": "tsx scripts/metricsServer.ts",
    "perf:doubtkb": "tsx scripts/perf/doubtkb_bench.ts",
    "render:diagrams": "npx @mermaid-js/mermaid-cli -i docs/diagrams/submit-enqueue.mmd -o docs/diagrams/submit-enqueue.png && npx @mermaid-js/mermaid-cli -i docs/diagrams/worker-claim-execute.mmd -o docs/diagrams/worker-claim-execute.png && npx @mermaid-js/mermaid-cli -i docs/diagrams/reconciler-aggregation.mmd -o docs/diagrams/reconciler-aggregation.png",
    "test:unit": "cross-env NODE_OPTIONS=--max-old-space-size=4096 node scripts/run-focused-tests.cjs -- --runInBand",
    "ci:check-playwright": "node -e \"(async()=>{try{await import('playwright'); console.log('playwright:ok'); process.exit(0);}catch(e){console.error('playwright:missing', String(e)); process.exit(2);}})()\"",
    "orchestrator:start": "tsx worker/orchestrator.ts",
    "seed": "node scripts/seed-taxonomy.cjs",
    "seed:dashboard": "node scripts/seed-dashboard-test-data.cjs",
    "seed:dashboard:dry": "node scripts/seed-dashboard-test-data.cjs --dry-run",
    "test:mvp-flow": "node scripts/test-mvp-flow.cjs",
    "seed-db-ai-content-infra": "tsx scripts/seed-database.ts",
    "reset-db-ai-content-infra": "tsx scripts/reset-remote-db.ts",
    "seed-and-reset-db-ai-content-infra": "npm run seed-db-ai-content-infra && npm run reset-db-ai-content-infra",
    "build:workers": "node scripts/prisma-generate-with-retry.cjs && tsc -p tsconfig.workers.json && npx tsc-alias -p tsconfig.workers.json && node scripts/fix-dist-imports.cjs dist/worker",
    "build:scripts": "tsc --outDir scripts --project scripts/tsconfig.json || true",
    "worker:dev": "tsx worker/dev-supervisor.ts",
    "scheduler:dev": "tsx worker/scheduler.ts",
    "postbuild": "node scripts/fix-dist-imports.cjs dist/worker && node scripts/ensure-regeneration-shim.cjs ~\\ai-tutor || true",
    "dist:shim": "node scripts/create-dist-shims.cjs",
    "dist:parse-shim": "node scripts/parse-and-shim.cjs --log logs/worker-error.log --root dist",
    "pm2:start-worker": "pm2 start ecosystem.config.cjs --only content-engine-worker --update-env",
    "pm2:restart-worker": "pm2 restart content-engine-worker --update-env",
    "check-redis-keys": "node scripts/check-redis-keys.js",
    "verify:vps": "bash scripts/vps-verification.sh --auto",
    "verify:dist": "node scripts/verify-dist.cjs",
    "ensure:env": "bash scripts/ensure-env-perms.sh",
    "ci:check-env": "node scripts/check-env-not-tracked.cjs",
    "ci:prebuild": "npm run ci:check-env && npm run ci:check-playwright && npm run verify:dist",
    "deploy:prep": "bash scripts/ensure-env-perms.sh && npm run verify:dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "migrate:docker": "powershell -File scripts\\docker-commands.ps1 migrate",
    "worker:start": "tsx src/workers/index.ts",
    "reconciler:start": "tsx src/jobs/reconciler/index.ts",
    "outbox:start": "tsx src/jobs/outbox/dispatcher.ts",
    "docker:build": "docker build -t edtech-backend .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "seed:ai-content": "node scripts/seed-ai-content.cjs",
    "seed:weights": "node scripts/seed-board-chapter-weights.cjs",
    "seed:ai-content:all": "node scripts/seed-ai-content-and-weights.cjs",
    "seed:taxonomy": "node scripts/seed-taxonomy.cjs",
    "ingest:cli": "node ingest.cjs",
    "ingest:seed-cbse-grade10": "node scripts/seed-cbse-grade10.cjs",
    "ingest:retry": "node ingest.cjs --retry-failed",
    "ingest:scrape": "node ingest.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.428.0",
    "@aws-sdk/client-secrets-manager": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.428.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@heroicons/react": "^2.2.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@next/swc-wasm-nodejs": "^16.1.6",
    "@prisma/client": "6.19.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@sentry/nextjs": "^10.36.0",
    "@smithy/smithy-client": "^4.11.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@yusifaliyevpro/countries": "^2.2.2",
    "accept-language-parser": "^1.5.0",
    "ajv": "8.18.0",
    "autoprefixer": "10.4.2",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.66.0",
    "chalk": "^4.1.2",
    "csstype": "^3.1.3",
    "dotenv": "^17.3.1",
    "eventemitter3": "5.0.4",
    "fast-equals": "^5.4.0",
    "framer-motion": "^12.23.16",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.544.0",
    "minimist": "^1.2.8",
    "nanoid": "^5.1.6",
    "next": "^16.1.6",
    "next-auth": "^4.24.11",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.13",
    "openai": "^5.23.2",
    "pathe": "^2.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.449",
    "postcss": "^8.5.6",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^8.0.7",
    "react-speech-recognition": "^4.0.1",
    "recharts": "^2.15.2",
    "rehype-sanitize": "^5.0.1",
    "resend": "^6.10.0",
    "sanscript": "^0.0.2",
    "serwist": "^9.5.7",
    "slugify": "^1.6.6",
    "swr": "^2.2.4",
    "tailwindcss": "3.4.6",
    "tesseract.js": "^4.1.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@kubernetes/client-node": "^1.4.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/node": "^20",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "express": "^5.2.1",
    "globals": "^16.4.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jiti": "^2.6.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.5.3",
    "prisma": "6.19.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,cjs,js,mjs}": [
      "python scripts/fix-smart-quotes.py"
    ]
  },
  "overrides": {
    "cookie": "^0.7.2",
    "prisma": "6.19.1",
    "@prisma/client": "6.19.1",
    "@prisma/instrumentation": "6.19.1"
  }
}
