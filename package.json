{
  "name": "ai-tutor-india",
  "version": "0.1.0",
  "private": true,
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@dhiwise/component-tagger",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": " CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 15 TypeScript app functionality"
  },
  "scripts": {
    "dev": "npm run lint && npm run type-check && next dev",
    "prepare": "husky install",
    "build": "npm run lint && npx prisma generate && npm run type-check && npm run build:workers && next build",
    "start": "next start",
    "export": "next export",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern dist/** --ignore-pattern build/** --ignore-pattern .next/** --max-warnings=0",
    "test:eslint-rules": "node ./eslint-rules/tests/run-rule-tests.cjs",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
    "clear-auth": "set CONFIRM=true && node -r ts-node/register scripts/clear-auth-tables.ts",
    "test": "npm run lint && npm run type-check",
    "health-check": "node scripts/health-check.js",
    "test:integration": "node tests/integration/audit-log.test.js",
    "test:integration:evaluator": "node -r ts-node/register/transpile-only tests/integration/alert-evaluator.test.ts",
    "test:unit": "jest --runInBand",
    "orchestrator:start": "ts-node -r tsconfig-paths/register worker/orchestrator.ts",
    "seed-db-ai-content-infra": "node -r ts-node/register scripts/seed-database.ts",
    "reset-db-ai-content-infra": "node -r ts-node/register scripts/reset-remote-db.ts",
    "seed-and-reset-db-ai-content-infra": "npm run seed-db-ai-content-infra && npm run reset-db-ai-content-infra",
    "build:workers": "tsc -p tsconfig.workers.json && npx tsc-alias -p tsconfig.workers.json"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-s3": "^3.428.0",
    "@aws-sdk/client-secrets-manager": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.428.0",
    "@dhiwise/component-tagger": "^1.0.10",
    "@heroicons/react": "^2.2.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@yusifaliyevpro/countries": "^2.2.2",
    "accept-language-parser": "^1.5.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.66.0",
    "framer-motion": "^12.23.16",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.544.0",
    "minimist": "^1.2.8",
    "nanoid": "^5.1.6",
    "next": "^14.2.33",
    "next-auth": "^4.24.11",
    "next-pwa": "^5.6.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.11",
    "openai": "^5.23.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.449",
    "prom-client": "^14.0.0",
    "razorpay": "^2.9.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^8.0.7",
    "react-speech-recognition": "^4.0.1",
    "recharts": "^2.15.2",
    "rehype-sanitize": "^5.0.1",
    "sanscript": "^0.0.2",
    "slugify": "^1.6.6",
    "swr": "^2.2.4",
    "tesseract.js": "^4.1.1",
    "uuid": "^13.0.0",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.2",
    "@types/node": "^20",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.0",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.4.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.6.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prisma": "^6.19.0",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "tsc-alias": "^1.8.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
