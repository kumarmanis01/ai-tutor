FROM node:20-alpine AS builder
WORKDIR /app

# Install build tools required by some native deps
# Use --no-cache and specific mirror for faster downloads
RUN apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/v3.19/main \
    python3 make g++ bash

# Copy package manifests first to leverage Docker cache for deps
# Copy package manifests first to leverage Docker cache for deps
COPY package.json package-lock.json* ./

# Install all deps (including dev) so Prisma/Next build and tools are available
RUN npm ci --no-audit --progress=false --prefer-offline

# Copy the prisma schema (schema.prisma and related files) so `prisma generate`
# can run before copying the full repository. This keeps cache layers efficient
# and ensures the schema is present during the builder stage.
COPY prisma ./prisma

# Run Prisma generate here so schema issues surface at image build time for dev
RUN npx prisma generate --schema=prisma/schema.prisma

# Ensure Playwright browsers and dependencies are installed in the builder image
# This makes Playwright rendering available at runtime (if Playwright package present).
RUN npx playwright install --with-deps || true

# Copy rest of the repo and build
COPY . ./

FROM node:20-alpine AS runner
WORKDIR /app
COPY --from=builder /app /app
ENV NODE_ENV=production

# Minimal runtime deps are already installed in /app/node_modules
# Install curl for healthchecks, netcat for port checking, postgresql-client for migrations
RUN apk add --no-cache curl netcat-openbsd postgresql-client redis

EXPOSE 3000
# Add a small entrypoint to route to the correct service at runtime
COPY ./scripts/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh || true
COPY ./scripts/entrypoint.sh /app/scripts/entrypoint.sh
RUN chmod +x /app/scripts/entrypoint.sh || true
ENTRYPOINT ["/bin/sh", "/app/scripts/entrypoint.sh"]

CMD ["web"]
