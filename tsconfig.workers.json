{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/worker",
    "rootDir": ".",
    "composite": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*", "*"] ,
      "@/worker/*": ["worker/*"]
    }
  },
  "include": [
    "worker/**/*.ts",
    "lib/**/*.ts",
    "regeneration/**/*.ts",
    "hydrators/**/*.ts",
    "jobs/**/*.ts",
    "queues/**/*.ts",
    "producers/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "scripts",
    "worker/k8s-adapter.ts",
    "worker/metrics-server.ts",
    "worker/dev-entry.ts",
    "worker/dev-supervisor.ts",
    "lib/tests.ts",
    "lib/mock/selectMockQuestions.ts",
    "lib/diagnostics/diagnosticQuestionService.ts",
    "lib/exporters/pdf.ts",
    "lib/aiContext.ts",
    "lib/alerts.ts",
    "lib/analytics/client.ts",
    "lib/analyticsClient.ts",
    "lib/inputHandlers.ts",
    "lib/onboarding.ts",
    "lib/resizeImage.ts",
    "lib/session/sessionActions.ts",
    "lib/speech.ts",
    "lib/toast.ts"
  ]
}