{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "node",
    "target": "ES2022"
  },
  "include": [
    "app/worker/**/*.ts"
  ],
  "exclude": [
    "worker/**",
    "scripts/**",
    "tests/**",
    "app/**",
    "lib/**"
  ]
}