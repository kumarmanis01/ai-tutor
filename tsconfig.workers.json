{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "module": "es2022",
    "target": "ES2020",
    "incremental": false
  },
  "include": [
    "workers/**/*.ts",
    "worker/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "types/**/*.d.ts"
  ]
}
