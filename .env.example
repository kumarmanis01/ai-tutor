# ── Database ──────────────────────────────────────────────────────────────────
# Primary connection (goes through PgBouncer in docker-compose; direct for local without PgBouncer)
DATABASE_URL=postgresql://postgres:pass@localhost:5432/ai_dev

# Direct connection bypassing PgBouncer -- required for Prisma migrate/introspect.
# For local dev without PgBouncer, set this equal to DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:pass@localhost:5432/ai_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# EMAIL_PROVIDER defaults to 'resend'. Only RESEND_API_KEY is required.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=no-reply@send.spinzyacademy.com
FROM_NAME=Spinzy Academy
# EMAIL_FROM=Spinzy Academy <no-reply@send.spinzyacademy.com>  # overrides FROM_NAME + FROM_EMAIL

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ── Anthropic (failover only) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_AI_TUTOR=true
ENABLE_DISTRESS_DETECTION=false   # do NOT set to true -- see CLAUDE.md
NEXT_PUBLIC_CONSENT_LIVE=false    # do NOT set to true until lawyer approves
ROLLOUT_PERCENTAGE=5
LLM_MODE=real
LLM_SAFE_MODE=true

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
