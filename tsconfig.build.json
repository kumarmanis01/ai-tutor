{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "ES2022",
    "moduleResolution": "node",
    "target": "ES2022",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "app/worker",
    "lib",
    "queues",
    "workers",
    "producers",
    "scripts",
    "types"
  ]
  ,
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "tests",
    "public"
  ]
}
