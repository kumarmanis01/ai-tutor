FROM node:20-alpine

WORKDIR /app

# Copy repository into image (clean build context - no host node_modules interference)
COPY . /app

ENV NODE_ENV=development

# Install dev dependencies needed for running tests
RUN npm ci --include=dev --no-audit --no-fund

# Generate Prisma client
RUN npx prisma generate

# Default command runs the HydrateAll validation tests; can be overridden by docker run
# Use docker-compose.test.yml for full container-based validation with postgres + redis
CMD ["sh", "-c", "npx jest tests/integration/hydrateAll-validation.test.ts --runInBand --forceExit"]
